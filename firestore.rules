rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is a member of a given menu.
    // Used by the dishes rules so only menu members can read/write dishes.
    function isMemberOf(menuId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/menus/$(menuId)).data.memberIDs;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Menus ──────────────────────────────────────────────────────────────
    match /menus/{menuId} {
      // Only members can read menu details.
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.memberIDs;

      // Any authenticated user can create a menu (they become creator + first member).
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.creatorID
                    && request.auth.uid in request.resource.data.memberIDs;

      // Creator can update any field.
      // Non-creator members can only add themselves (invitation acceptance).
      allow update: if request.auth != null
                    && (
                      request.auth.uid == resource.data.creatorID
                      || request.auth.uid in request.resource.data.memberIDs
                    );

      // Only the creator can delete the menu.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.creatorID;
    }

    // ── Invitations ────────────────────────────────────────────────────────
    match /invitations/{invitationId} {
      // Recipient reads their own invitations (for the listener).
      // Sender reads invitations they created (for duplicate-check query).
      allow read:   if request.auth != null
                    && (request.auth.uid == resource.data.toUserID
                        || request.auth.uid == resource.data.fromUserID);

      // Menu creator sends invitations.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.fromUserID;

      // Recipient updates status (accept / decline).
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.toUserID;
    }

    // ── Dishes ─────────────────────────────────────────────────────────────
    // Menu members can read dishes; owners can always read their own.
    match /dishes/{dishId} {
      allow read:   if request.auth != null
                    && (request.auth.uid == resource.data.ownerID
                        || isMemberOf(resource.data.menuID));

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerID
                    && isMemberOf(request.resource.data.menuID);

      allow update, delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerID;
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.buyerID
                      || request.auth.uid == resource.data.chefID);

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.buyerID;

      allow update: if request.auth != null
                    && request.auth.uid == resource.data.chefID;
    }

    // ── Top-ups ────────────────────────────────────────────────────────────
    match /topups/{topupId} {
      allow read:   if request.auth != null
                    && request.auth.uid == resource.data.userID;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userID;
    }

    // ── Payout Ledger ──────────────────────────────────────────────────────
    match /payoutLedger/{ledgerId} {
      // resource is null when the doc doesn't exist yet — markDone() reads it
      // as an idempotency check before deciding whether to credit the chef.
      allow read:   if request.auth != null
                    && (resource == null
                        || request.auth.uid == resource.data.chefId);
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.chefId;
    }
  }
}
